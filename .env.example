# ─── Supabase ────────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE. Bypasses every RLS policy in the database.
# Never prefix with NEXT_PUBLIC_. Never commit. If it leaks, rotate it in
# Supabase immediately — it is equivalent to the database password.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ───────────────────────────────────────────────────────────────
# Key for the daily-rotating HMAC of visitor IPs (we never store raw IPs).
# Generate: openssl rand -hex 32
# Rotating this invalidates yesterday's rate-limit buckets. That's fine.
IP_HASH_SECRET=

# Canonical origin, used for the CSRF origin check on /api/contact.
# Must match exactly, no trailing slash. e.g. https://webcraft.pl
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email login (admin dashboard) ──────────────────────────────────────────
# No env var here: login uses Supabase's built-in emailed one-time code.
# In Supabase: Authentication → Sign In / Providers → DISABLE global signups
#   (we also pass shouldCreateUser:false client-side — belt and braces).
# Then create your user by hand and add it to public.admin_users
#   (see the seed block at the bottom of supabase/schema.sql).

# ─── SEO ────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL (above) is now ALSO the canonical origin for metadata,
# canonicals, robots.txt, sitemap.xml and the JSON-LD graph.
#
# ⚠️ IF IT IS UNSET, LOCALHOST, OR THE webcraft.studio PLACEHOLDER, THE SITE
# SHIPS NOINDEX ON PURPOSE (robots.txt Disallow: / + noindex on every page).
# That guard exists so a preview deploy is never indexed under the wrong
# hostname — but it means a production deploy WITHOUT this variable set is
# invisible to Google. Set it to the real origin, no trailing slash.
